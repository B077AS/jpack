<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.b077as</groupId>
    <artifactId>jpack-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jpack-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>
  <name>jpack-maven-plugin</name>
  <description>Builds the install folder of a Java app (stub, runtime, jars) and the release files its updates are served from.</description>

  <prerequisites>
    <maven>3.9.0</maven>
  </prerequisites>

  <dependencies>
    <dependency>
      <groupId>io.github.b077as</groupId>
      <artifactId>jpack-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${maven.plugin.tools.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The prebuilt stubs (see build-stub.ps1 / build-stub.sh), one folder per platform. They travel inside the plugin
           so that an app's build needs no Rust. -->
      <resource>
        <directory>${project.basedir}/../stubs</directory>
        <targetPath>io/github/b077as/jpack/stubs</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <configuration>
          <goalPrefix>jpack</goalPrefix>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
