<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.b077as</groupId>
    <artifactId>jpack-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>jpack-tests</artifactId>
  <name>jpack-tests</name>
  <description>End-to-end tests: real releases built by the packager, served by a local web server, installed and updated by the real stub.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipPublishing>true</skipPublishing>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.b077as</groupId>
      <artifactId>jpack-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.b077as</groupId>
      <artifactId>jpack-maven-plugin</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- Where build-stub.ps1 / build-stub.sh put the stub. Without one the tests are skipped. -->
            <jpack.stubs>${project.basedir}/../stubs</jpack.stubs>
            <jpack.lab>${project.build.directory}/lab</jpack.lab>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
